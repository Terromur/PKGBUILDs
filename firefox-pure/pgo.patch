+++ b/build/pgo/js-input/fetch-bench.html
@@ -0,0 +1,250 @@
+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>Fetch / Networking bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre-wrap; margin-bottom: 8px; }
+  #status.error { color: #b00020; font-weight: bold; }
+  #status.ok { color: #1a7f37; }
+  #where { color: #666; font: 12px monospace; margin-bottom: 8px; }
+  table { border-collapse: collapse; margin: 8px 0; }
+  th, td { border: 1px solid #ccc; padding: 2px 8px; font: 12px monospace; text-align: left; }
+  th { background: #f0f0f0; }
+</style>
+</head>
+<body>
+<div id="where"></div>
+<div id="status">fetch-bench: starting…</div>
+<table id="probe"></table>
+<script>
+// Exercises networking stack: XHR, fetch with ArrayBuffer/text,
+// Promise.all parallelism, request headers, response streaming,
+// AbortController cancellation, AbortSignal.timeout.
+//
+// URL resolution strategy:
+//   1. Try the canonical docroot paths (works under profileserver.py).
+//   2. If they 404, fall back to location.href (the test file itself) so
+//      the benchmark can still run from a plain `python3 -m http.server`
+//      started in the directory that only contains the *-bench.html files.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const statusEl = document.getElementById("status");
+const whereEl = document.getElementById("where");
+const probeEl = document.getElementById("probe");
+
+function setStatus(text, cls = "") {
+  statusEl.textContent = text;
+  statusEl.className = cls;
+}
+
+whereEl.textContent =
+  "page: " + location.href +
+  "  |  protocol: " + location.protocol;
+
+// Candidate URLs. Order matters: first success wins.
+const CANDIDATES = {
+  QUIT:  ["/quit.html", "quit.html"],
+  INDEX: ["/index.html", "index.html"],
+  TEXT:  ["/server-locations.txt", "server-locations.txt"],
+};
+
+// Self-fallback: guaranteed to exist.
+const SELF = location.href.split("?")[0];
+
+async function probeOne(url) {
+  const t0 = now();
+  try {
+    const r = await fetch(url, { cache: "no-store" });
+    const t1 = now();
+    return { ok: r.ok, status: r.status, ms: (t1 - t0) | 0 };
+  } catch (e) {
+    return { ok: false, error: String((e && e.message) || e) };
+  }
+}
+
+async function resolveUrl(name, list) {
+  for (const cand of list) {
+    const r = await probeOne(cand);
+    if (r.ok) return { url: cand, probe: r };
+  }
+  // Nothing worked; fall back to self.
+  const r = await probeOne(SELF);
+  return { url: SELF, probe: r, fallback: true };
+}
+
+async function runProbes() {
+  probeEl.innerHTML = "<tr><th>name</th><th>URL</th><th>status</th><th>time</th></tr>";
+  const resolved = {};
+  for (const [name, list] of Object.entries(CANDIDATES)) {
+    let chosen;
+    for (const cand of list) {
+      const r = await probeOne(cand);
+      const row = probeEl.insertRow(-1);
+      row.insertCell(-1).textContent = name;
+      row.insertCell(-1).textContent = cand;
+      row.insertCell(-1).textContent = r.ok ? String(r.status) : (r.error || "FAIL");
+      row.insertCell(-1).textContent = r.ms != null ? r.ms + " ms" : "-";
+      if (r.ok && !chosen) chosen = cand;
+    }
+    if (chosen) {
+      resolved[name] = chosen;
+    } else {
+      // Fallback to self
+      const r = await probeOne(SELF);
+      const row = probeEl.insertRow(-1);
+      row.insertCell(-1).textContent = name + " (self)";
+      row.insertCell(-1).textContent = SELF;
+      row.insertCell(-1).textContent = r.ok ? String(r.status) : (r.error || "FAIL");
+      row.insertCell(-1).textContent = r.ms != null ? r.ms + " ms" : "-";
+      resolved[name] = SELF;
+    }
+  }
+  return resolved;
+}
+
+function bust(u) {
+  return u + (u.includes("?") ? "&" : "?") + "_=" + Math.random();
+}
+
+function makeFetchers(urls) {
+  const QUIT = urls.QUIT;
+  const INDEX = urls.INDEX;
+  const TEXT = urls.TEXT;
+
+  async function fetchText() {
+    const r = await fetch(bust(TEXT), { cache: "no-store" });
+    if (!r.ok) throw new Error(`HTTP ${r.status} for ${TEXT}`);
+    await r.text();
+  }
+
+  async function fetchArrayBuffer() {
+    const r = await fetch(bust(QUIT), { cache: "no-store" });
+    if (!r.ok) throw new Error(`HTTP ${r.status} for ${QUIT}`);
+    await r.arrayBuffer();
+  }
+
+  async function fetchWithHeaders() {
+    const r = await fetch(bust(INDEX), {
+      cache: "no-store",
+      headers: { "X-PGO-Bench": "1", "Accept": "text/html,*/*;q=0.1" },
+    });
+    if (!r.ok) throw new Error(`HTTP ${r.status} for ${INDEX}`);
+    const t = await r.text();
+    return t.length;
+  }
+
+  function xhrFetch() {
+    return new Promise((resolve, reject) => {
+      const x = new XMLHttpRequest();
+      x.open("GET", bust(QUIT), true);
+      x.responseType = "arraybuffer";
+      x.onload = () =>
+        x.status >= 200 && x.status < 300
+          ? resolve(x.status)
+          : reject(new Error(`XHR ${x.status}`));
+      x.onerror = () => reject(new Error("XHR network error"));
+      x.send();
+    });
+  }
+
+  async function parallel() {
+    const list = [QUIT, INDEX, TEXT, QUIT, INDEX].map(bust);
+    const results = await Promise.all(
+      list.map(u =>
+        fetch(u, { cache: "no-store" }).then(r => {
+          if (!r.ok) throw new Error(`HTTP ${r.status} for ${u}`);
+          return r.arrayBuffer();
+        })
+      )
+    );
+    return results.length;
+  }
+
+  async function abortOnce() {
+    const ac = new AbortController();
+    const p = fetch(bust(INDEX), { signal: ac.signal, cache: "no-store" });
+    ac.abort();
+    try { await p; } catch (e) { /* expected AbortError */ }
+  }
+
+  async function timeoutOnce() {
+    if (typeof AbortSignal === "undefined" ||
+        typeof AbortSignal.timeout !== "function") return;
+    try {
+      await fetch(bust(INDEX), {
+        signal: AbortSignal.timeout(5000),
+        cache: "no-store",
+      });
+    } catch (e) { /* ignore */ }
+  }
+
+  return {
+    fetchText, fetchArrayBuffer, fetchWithHeaders,
+    xhrFetch, parallel, abortOnce, timeoutOnce,
+  };
+}
+
+async function run() {
+  if (location.protocol === "file:") {
+    setStatus(
+      "fetch-bench: skipped — file:// origin cannot use fetch(). " +
+      "Serve this directory over HTTP (e.g. `python3 -m http.server 8888`) " +
+      "or run through build/pgo/profileserver.py.",
+      "error"
+    );
+    return;
+  }
+
+  const start = now();
+  setStatus("fetch-bench: probing URLs …");
+  const urls = await runProbes();
+  setStatus(
+    "fetch-bench: using QUIT=" + urls.QUIT +
+    " INDEX=" + urls.INDEX +
+    " TEXT=" + urls.TEXT,
+    "ok"
+  );
+
+  const F = makeFetchers(urls);
+
+  let textN = 0, abN = 0, hdrN = 0, xhrN = 0, parN = 0, abortN = 0, timeoutN = 0, errN = 0;
+
+  while (now() - start < TIME_BUDGET) {
+    try {
+      await F.fetchText();        textN++;    if (now() - start >= TIME_BUDGET) break;
+      await F.fetchArrayBuffer(); abN++;      if (now() - start >= TIME_BUDGET) break;
+      await F.fetchWithHeaders(); hdrN++;     if (now() - start >= TIME_BUDGET) break;
+      await F.xhrFetch();         xhrN++;     if (now() - start >= TIME_BUDGET) break;
+      await F.parallel();         parN++;     if (now() - start >= TIME_BUDGET) break;
+      await F.abortOnce();        abortN++;   if (now() - start >= TIME_BUDGET) break;
+      await F.timeoutOnce();      timeoutN++;
+    } catch (e) {
+      errN++;
+      console.error("[fetch] error", e);
+      if (errN >= 3) break;
+    }
+
+    setStatus(
+      `fetch-bench: text=${textN} ab=${abN} hdr=${hdrN} xhr=${xhrN} ` +
+      `par=${parN} abort=${abortN} timeout=${timeoutN} err=${errN} ` +
+      `elapsed=${(now() - start) | 0}ms`
+    );
+  }
+
+  const summary =
+    `[fetch] text=${textN} ab=${abN} hdr=${hdrN} xhr=${xhrN} ` +
+    `par=${parN} abort=${abortN} timeout=${timeoutN} err=${errN}`;
+  console.log(summary);
+  setStatus("fetch-bench: done — " + summary, "ok");
+}
+
+run().catch(e => {
+  const msg = "fetch-bench: fatal — " + ((e && e.message) || e);
+  setStatus(msg, "error");
+  console.error("[fetch] fatal", e);
+});
+</script>
+</body>
+</html>
