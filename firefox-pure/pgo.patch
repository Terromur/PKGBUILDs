+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>WebGL bench</title>
+</head>
+<body>
+<canvas id="c" width="512" height="512"></canvas>
+<script>
+// Exercises WebGL: buffer uploads, shader compile/link, draw calls,
+// texture uploads, uniform updates, depth test, blending.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const canvas = document.getElementById("c");
+const gl = canvas.getContext("webgl", { antialias: true, alpha: false });
+if (!gl) {
+  console.log("[webgl] unavailable");
+} else {
+  const VS = `
+    attribute vec2 aPos;
+    attribute vec3 aColor;
+    uniform float uTime;
+    varying vec3 vColor;
+    void main() {
+      float s = sin(uTime + aPos.x * 3.0);
+      float c = cos(uTime + aPos.y * 3.0);
+      gl_Position = vec4(aPos.x + s * 0.1, aPos.y + c * 0.1, 0.0, 1.0);
+      vColor = aColor;
+    }`;
+  const FS = `
+    precision mediump float;
+    varying vec3 vColor;
+    void main() { gl_FragColor = vec4(vColor, 1.0); }`;
+
+  function compile(type, src) {
+    const s = gl.createShader(type);
+    gl.shaderSource(s, src);
+    gl.compileShader(s);
+    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
+      throw new Error(gl.getShaderInfoLog(s));
+    }
+    return s;
+  }
+  const prog = gl.createProgram();
+  gl.attachShader(prog, compile(gl.VERTEX_SHADER, VS));
+  gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FS));
+  gl.linkProgram(prog);
+  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
+    throw new Error(gl.getProgramInfoLog(prog));
+  }
+  gl.useProgram(prog);
+
+  const COUNT = 300;
+  const pos = new Float32Array(COUNT * 2);
+  const col = new Float32Array(COUNT * 3);
+  for (let i = 0; i < COUNT; i++) {
+    const a = (i / COUNT) * Math.PI * 2;
+    pos[i * 2] = Math.cos(a);
+    pos[i * 2 + 1] = Math.sin(a);
+    col[i * 3] = (i % 7) / 7;
+    col[i * 3 + 1] = (i % 11) / 11;
+    col[i * 3 + 2] = (i % 13) / 13;
+  }
+  const posBuf = gl.createBuffer();
+  gl.bindBuffer(gl.ARRAY_BUFFER, posBuf);
+  gl.bufferData(gl.ARRAY_BUFFER, pos, gl.DYNAMIC_DRAW);
+  const aPos = gl.getAttribLocation(prog, "aPos");
+  gl.enableVertexAttribArray(aPos);
+  gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
+
+  const colBuf = gl.createBuffer();
+  gl.bindBuffer(gl.ARRAY_BUFFER, colBuf);
+  gl.bufferData(gl.ARRAY_BUFFER, col, gl.STATIC_DRAW);
+  const aColor = gl.getAttribLocation(prog, "aColor");
+  gl.enableVertexAttribArray(aColor);
+  gl.vertexAttribPointer(aColor, 3, gl.FLOAT, false, 0, 0);
+
+  const uTime = gl.getUniformLocation(prog, "uTime");
+  gl.enable(gl.DEPTH_TEST);
+  gl.enable(gl.BLEND);
+  gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+  // 64x64 procedural texture
+  const texData = new Uint8Array(64 * 64 * 4);
+  for (let i = 0; i < texData.length; i += 4) {
+    texData[i] = i & 0xff;
+    texData[i + 1] = (i * 3) & 0xff;
+    texData[i + 2] = (i * 7) & 0xff;
+    texData[i + 3] = 255;
+  }
+  const tex = gl.createTexture();
+  gl.bindTexture(gl.TEXTURE_2D, tex);
+  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 64, 64, 0, gl.RGBA, gl.UNSIGNED_BYTE, texData);
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);
+
+  (function run() {
+    const start = now();
+    let frames = 0;
+    while (now() - start < TIME_BUDGET) {
+      const t = frames * 0.05;
+      gl.viewport(0, 0, canvas.width, canvas.height);
+      gl.clearColor(0.05, 0.05, 0.1, 1.0);
+      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+      gl.uniform1f(uTime, t);
+      // Re-upload positions each frame to exercise bufferSubData.
+      gl.bindBuffer(gl.ARRAY_BUFFER, posBuf);
+      gl.bufferSubData(gl.ARRAY_BUFFER, 0, pos);
+      gl.drawArrays(gl.TRIANGLE_FAN, 0, COUNT);
+      gl.drawArrays(gl.LINE_LOOP, 0, COUNT);
+      if ((frames & 15) === 0) {
+        // readPixels exercises sync path
+        const px = new Uint8Array(4);
+        gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);
+      }
+      frames++;
+    }
+    console.log(`[webgl] frames=${frames}`);
+  })();
+}
+</script>
+</body>
+</html>

