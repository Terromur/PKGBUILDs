+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>Web Workers bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre-wrap; }
+</style>
+</head>
+<body>
+<div id="status">workers: starting…</div>
+<script>
+// Exercises Web Workers:
+//   - Worker construction from Blob URL
+//   - postMessage structured-clone serialization
+//   - transferable ArrayBuffers (zero-copy)
+//   - SharedArrayBuffer + Atomics (when available)
+//   - worker.terminate() teardown
+//
+// All errors are captured so a single failing worker can't silently kill
+// the whole run and leave a blank page.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const statusEl = document.getElementById("status");
+
+const WORKER_SRC = `
+  self.onmessage = function(e) {
+    const { buf, sab, n } = e.data;
+    const arr = new Uint32Array(buf);
+    let s = 0;
+    for (let i = 0; i < n; i++) s = (s + arr[i % arr.length]) >>> 0;
+    if (sab) {
+      const sarr = new Uint32Array(sab);
+      Atomics.add(sarr, 0, s);
+      Atomics.notify(sarr, 0);
+    }
+    // Return a fresh buffer back, transferring it to exercise the
+    // transferable path in both directions.
+    const out = new ArrayBuffer(1024);
+    new Uint32Array(out)[0] = s;
+    self.postMessage({ out, s }, [out]);
+  };
+`;
+
+function makeWorker() {
+  const blob = new Blob([WORKER_SRC], { type: "application/javascript" });
+  const url = URL.createObjectURL(blob);
+  const w = new Worker(url);
+  URL.revokeObjectURL(url);
+  return w;
+}
+
+async function run() {
+  const start = now();
+
+  if (typeof Worker === "undefined") {
+    statusEl.textContent = "workers: Worker API unavailable";
+    console.warn("[workers] Worker undefined");
+    return;
+  }
+
+  const hw = navigator.hardwareConcurrency || 4;
+  const N_WORKERS = Math.max(2, hw - 1);
+  const workers = [];
+  for (let i = 0; i < N_WORKERS; i++) {
+    try {
+      workers.push(makeWorker());
+    } catch (e) {
+      console.error("[workers] failed to spawn worker", e);
+    }
+  }
+  if (workers.length === 0) {
+    statusEl.textContent = "workers: failed to spawn any worker";
+    return;
+  }
+
+  const hasSAB = typeof SharedArrayBuffer !== "undefined";
+  const sab = hasSAB ? new SharedArrayBuffer(64) : null;
+
+  let round = 0;
+  let totalJobs = 0;
+  let errors = 0;
+
+  while (now() - start < TIME_BUDGET) {
+    const jobs = [];
+    for (let i = 0; i < workers.length; i++) {
+      const buf = new ArrayBuffer(4096);
+      new Uint32Array(buf).fill(round + i);
+      const w = workers[i];
+      jobs.push(new Promise(resolve => {
+        const onMsg = ev => {
+          w.removeEventListener("message", onMsg);
+          w.removeEventListener("error", onErr);
+          resolve(ev.data);
+        };
+        const onErr = ev => {
+          w.removeEventListener("message", onMsg);
+          w.removeEventListener("error", onErr);
+          errors++;
+          resolve(null);
+        };
+        w.addEventListener("message", onMsg);
+        w.addEventListener("error", onErr);
+        w.postMessage({ buf, sab, n: 1024 }, [buf]);
+      }));
+    }
+
+    try {
+      await Promise.all(jobs);
+    } catch (e) {
+      errors++;
+    }
+    totalJobs += workers.length;
+    round++;
+
+    if ((round & 3) === 0) {
+      statusEl.textContent =
+        `workers: rounds=${round} jobs=${totalJobs} workers=${workers.length} ` +
+        `sab=${hasSAB} errors=${errors} elapsed=${(now() - start) | 0}ms`;
+    }
+  }
+
+  for (const w of workers) {
+    try { w.terminate(); } catch (e) { /* ignore */ }
+  }
+
+  const summary =
+    `[workers] rounds=${round} jobs=${totalJobs} ` +
+    `workers=${workers.length} hw=${hw} sab=${hasSAB} errors=${errors}`;
+  statusEl.textContent = "workers: done — " + summary;
+  console.log(summary);
+}
+
+run().catch(e => {
+  statusEl.textContent = "workers: fatal — " + (e && e.message ? e.message : e);
+  console.error("[workers] fatal", e);
+});
+</script>
+</body>
+</html>

