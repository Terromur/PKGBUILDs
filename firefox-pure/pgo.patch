+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>Canvas 2D bench</title>
+</head>
+<body>
+<canvas id="c" width="512" height="512"></canvas>
+<script>
+// Exercises Canvas 2D: fills, strokes, gradients, transforms, text, images,
+// composite ops, clip regions, path ops.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const canvas = document.getElementById("c");
+const ctx = canvas.getContext("2d", { alpha: false });
+const W = canvas.width, H = canvas.height;
+
+const off = document.createElement("canvas");
+off.width = 64; off.height = 64;
+{
+  const octx = off.getContext("2d");
+  const g = octx.createLinearGradient(0, 0, 64, 64);
+  g.addColorStop(0, "red"); g.addColorStop(1, "blue");
+  octx.fillStyle = g;
+  octx.fillRect(0, 0, 64, 64);
+}
+
+function paintFrame(t) {
+  ctx.setTransform(1, 0, 0, 1, 0, 0);
+  ctx.globalCompositeOperation = "source-over";
+  ctx.fillStyle = "#101820";
+  ctx.fillRect(0, 0, W, H);
+
+  // Gradient fill
+  const lg = ctx.createLinearGradient(0, 0, W, H);
+  lg.addColorStop(0, `hsl(${(t * 30) % 360}, 80%, 50%)`);
+  lg.addColorStop(1, `hsl(${(t * 30 + 180) % 360}, 80%, 50%)`);
+  ctx.fillStyle = lg;
+  ctx.fillRect(0, 0, W, H);
+
+  // Transforms + strokes
+  ctx.save();
+  ctx.translate(W / 2, H / 2);
+  ctx.rotate(t * 0.02);
+  ctx.lineWidth = 2;
+  ctx.strokeStyle = "rgba(255,255,255,0.7)";
+  for (let i = 0; i < 40; i++) {
+    const a = (i / 40) * Math.PI * 2;
+    ctx.beginPath();
+    ctx.moveTo(0, 0);
+    ctx.lineTo(Math.cos(a) * 200, Math.sin(a) * 200);
+    ctx.stroke();
+  }
+  ctx.restore();
+
+  // Paths + clip
+  ctx.save();
+  ctx.beginPath();
+  ctx.arc(W / 2, H / 2, 120, 0, Math.PI * 2);
+  ctx.clip();
+  ctx.globalCompositeOperation = "multiply";
+  for (let i = 0; i < 20; i++) {
+    ctx.fillStyle = `rgba(${(i * 12) % 255}, 128, 200, 0.6)`;
+    ctx.fillRect((i * 37 + t) % W, (i * 53 + t * 2) % H, 60, 60);
+  }
+  ctx.restore();
+
+  // drawImage
+  ctx.globalCompositeOperation = "lighter";
+  for (let i = 0; i < 30; i++) {
+    ctx.drawImage(off, (i * 17 + t * 3) % W, (i * 23 + t * 5) % H, 32, 32);
+  }
+
+  // Text
+  ctx.globalCompositeOperation = "source-over";
+  ctx.fillStyle = "#fff";
+  ctx.font = "bold 24px sans-serif";
+  for (let i = 0; i < 20; i++) {
+    ctx.fillText(`frame ${t} #${i}`, 10, 30 + i * 24);
+  }
+  ctx.globalCompositeOperation = "source-over";
+}
+
+(function run() {
+  const start = now();
+  let frames = 0;
+  while (now() - start < TIME_BUDGET) {
+    paintFrame(frames);
+    // Force a readback occasionally to exercise pixel path.
+    if ((frames & 7) === 0) {
+      ctx.getImageData(0, 0, 1, 1).data[0];
+    }
+    frames++;
+  }
+  console.log(`[canvas2d] frames=${frames}`);
+})();
+</script>
+</body>
+</html>

