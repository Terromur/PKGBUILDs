+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>Web Animations bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 0; color: #333; }
+  #status {
+    position: fixed; top: 4px; left: 4px; z-index: 10;
+    background: rgba(255,255,255,0.85); padding: 2px 6px; border-radius: 3px;
+    font-variant-numeric: tabular-nums; white-space: pre;
+  }
+  #stage { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
+  .dot {
+    position: absolute;
+    width: 10px; height: 10px; border-radius: 5px;
+    background: #4d6bfe;
+    will-change: transform, opacity;
+    top: var(--y, 0px);
+    left: var(--x, 0px);
+  }
+</style>
+</head>
+<body>
+<div id="status">webanimations: starting…</div>
+<div id="stage"></div>
+<script>
+// Exercises Web Animations API:
+//   - many concurrent animations on Element.animate()
+//   - transform / opacity interpolation
+//   - timing functions and iterations
+//   - cancellation and natural completion
+//   - Document.getAnimations()
+//   - Animation.finished promise path
+//
+// Unlike the previous version, waves run to completion (short durations,
+// awaited via the `finished` promise) so the timeline/compositor pipeline
+// actually gets exercised before teardown.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const stage = document.getElementById("stage");
+const statusEl = document.getElementById("status");
+const N_DOTS = 200;
+
+const dots = [];
+for (let i = 0; i < N_DOTS; i++) {
+  const d = document.createElement("div");
+  d.className = "dot";
+  stage.appendChild(d);
+  dots.push(d);
+}
+
+const easings = [
+  "linear",
+  "ease-in",
+  "ease-out",
+  "ease-in-out",
+  "cubic-bezier(0.2, 0.8, 0.3, 1)",
+];
+
+function spawnWave(seed) {
+  const anims = [];
+  const vw = window.innerWidth - 10;
+  const vh = window.innerHeight - 10;
+  for (let i = 0; i < N_DOTS; i++) {
+    const d = dots[i];
+    const x = (i * 17 + seed * 5) % vw;
+    const y = (i * 23 + seed * 7) % vh;
+    // Set base position via CSS custom props so the dot is actually placed
+    // where the animation starts.
+    d.style.setProperty("--x", x + "px");
+    d.style.setProperty("--y", y + "px");
+
+    const dx = ((i % 5) - 2) * 40;
+    const dy = ((i % 7) - 3) * 40;
+    const a = d.animate(
+      [
+        { transform: `translate(0px, 0px) scale(0.5)`, opacity: 0.3 },
+        { transform: `translate(${dx}px, ${dy}px) scale(1.2)`, opacity: 1.0 },
+        { transform: `translate(0px, 0px) scale(0.5)`, opacity: 0.3 },
+      ],
+      {
+        duration: 40 + (i % 8) * 10,   // 40..110 ms
+        iterations: 1,
+        easing: easings[i % easings.length],
+        fill: "none",
+      }
+    );
+    anims.push(a);
+  }
+  return anims;
+}
+
+async function runWave(seed) {
+  const anims = spawnWave(seed);
+  // Await completion of all animations in this wave. This forces the
+  // timeline sampling, interpolation, and teardown codepaths to run.
+  await Promise.all(anims.map(a => a.finished.catch(() => {})));
+  return anims.length;
+}
+
+(async function run() {
+  const start = now();
+  let waves = 0;
+  let totalAnims = 0;
+
+  while (now() - start < TIME_BUDGET) {
+    const n = await runWave(waves);
+    totalAnims += n;
+
+    // Exercise Document.getAnimations() at the boundary between waves.
+    const live = document.getAnimations().length;
+    if (live > 0) { /* touch */ }
+
+    waves++;
+    if ((waves & 3) === 0) {
+      statusEl.textContent =
+        `webanimations: waves=${waves} anims=${totalAnims} ` +
+        `live=${live} elapsed=${(now() - start) | 0}ms`;
+    }
+  }
+
+  statusEl.textContent =
+    `webanimations: done — waves=${waves} anims=${totalAnims}`;
+  console.log(`[webanimations] waves=${waves} anims=${totalAnims}`);
+})();
+</script>
+</body>
+</html
+>

