+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>SVG bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre; }
+  svg { border: 1px solid #ddd; }
+</style>
+</head>
+<body>
+<div id="status">svg-bench: starting…</div>
+<svg id="root" width="800" height="600" xmlns="http://www.w3.org/2000/svg"></svg>
+<script>
+// Exercises SVG DOM: createElementNS, paths, text, gradients, filters,
+// transforms, getBBox, getCTM, path-data parsing.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const NS = "http://www.w3.org/2000/svg";
+const root = document.getElementById("root");
+const statusEl = document.getElementById("status");
+
+let gradCounter = 0;
+let filterCounter = 0;
+
+function makeDefs() {
+  const defs = document.createElementNS(NS, "defs");
+
+  // Linear gradient
+  const lg = document.createElementNS(NS, "linearGradient");
+  const gradId = `g${gradCounter++}`;
+  lg.setAttribute("id", gradId);
+  lg.setAttribute("x1", "0%"); lg.setAttribute("y1", "0%");
+  lg.setAttribute("x2", "100%"); lg.setAttribute("y2", "100%");
+  for (let i = 0; i <= 4; i++) {
+    const stop = document.createElementNS(NS, "stop");
+    stop.setAttribute("offset", `${i * 25}%`);
+    stop.setAttribute("stop-color", `hsl(${i * 90}, 80%, 55%)`);
+    lg.appendChild(stop);
+  }
+  defs.appendChild(lg);
+
+  // Gaussian blur filter
+  const filter = document.createElementNS(NS, "filter");
+  const filterId = `f${filterCounter++}`;
+  filter.setAttribute("id", filterId);
+  filter.setAttribute("x", "-10%"); filter.setAttribute("y", "-10%");
+  filter.setAttribute("width", "120%"); filter.setAttribute("height", "120%");
+  const blur = document.createElementNS(NS, "feGaussianBlur");
+  blur.setAttribute("stdDeviation", "2");
+  filter.appendChild(blur);
+  defs.appendChild(filter);
+
+  return { defs, gradId, filterId };
+}
+
+function buildScene(seed, gradId, filterId) {
+  const frag = document.createDocumentFragment();
+
+  // Paths with gradient fill + transform
+  for (let i = 0; i < 40; i++) {
+    const p = document.createElementNS(NS, "path");
+    const x = (i * 17 + seed) % 800;
+    const y = (i * 23 + seed * 2) % 600;
+    let d = `M ${x} ${y}`;
+    for (let k = 0; k < 6; k++) {
+      d += ` L ${x + ((k * 13) % 200)} ${y + ((k * 7) % 150)}`;
+    }
+    d += " Z";
+    p.setAttribute("d", d);
+    p.setAttribute("fill", `url(#${gradId})`);
+    p.setAttribute("stroke", "#222");
+    p.setAttribute("stroke-width", "1");
+    p.setAttribute("transform", `rotate(${(seed + i) % 360} ${x} ${y})`);
+    frag.appendChild(p);
+  }
+
+  // Text
+  for (let i = 0; i < 30; i++) {
+    const t = document.createElementNS(NS, "text");
+    t.setAttribute("x", (i * 23) % 800);
+    t.setAttribute("y", (i * 19) % 600);
+    t.setAttribute("font-size", "14");
+    t.setAttribute("fill", `hsl(${(i * 41) % 360}, 70%, 40%)`);
+    t.textContent = `label ${seed}-${i}`;
+    frag.appendChild(t);
+  }
+
+  // Circles with filter
+  for (let i = 0; i < 20; i++) {
+    const c = document.createElementNS(NS, "circle");
+    c.setAttribute("cx", (i * 37) % 800);
+    c.setAttribute("cy", (i * 29) % 600);
+    c.setAttribute("r", 8 + (i % 12));
+    c.setAttribute("fill", `hsl(${(i * 17) % 360}, 80%, 60%)`);
+    c.setAttribute("opacity", "0.8");
+    c.setAttribute("filter", `url(#${filterId})`);
+    frag.appendChild(c);
+  }
+
+  return frag;
+}
+
+(function run() {
+  const start = now();
+  let cycles = 0;
+  let acc = 0;
+
+  while (now() - start < TIME_BUDGET) {
+    const { defs, gradId, filterId } = makeDefs();
+    root.innerHTML = "";
+    root.appendChild(defs);
+    const frag = buildScene(cycles, gradId, filterId);
+    root.appendChild(frag);
+
+    // Force layout readback through geometry APIs.
+    const paths = root.querySelectorAll("path");
+    for (let i = 0; i < paths.length; i += 5) {
+      try {
+        const b = paths[i].getBBox();
+        acc += b.width + b.height;
+        const m = paths[i].getCTM();
+        if (m) acc += m.a + m.d;
+      } catch (e) {
+        // getBBox throws on some detached nodes; ignore.
+      }
+    }
+
+    // Re-parse path data via getAttribute to exercise the SVG path parser.
+    const first = paths[0];
+    if (first) {
+      const d = first.getAttribute("d");
+      if (d && d.length < 3) { /* touch */ }
+    }
+
+    // Force repaint.
+    void root.getBoundingClientRect().height;
+    cycles++;
+
+    if ((cycles & 15) === 0) {
+      statusEl.textContent =
+        `svg-bench: cycles=${cycles} elapsed=${(now() - start) | 0}ms`;
+    }
+  }
+
+  statusEl.textContent =
+    `svg-bench: done — cycles=${cycles} bboxAcc=${acc | 0}`;
+  console.log(`[svg] cycles=${cycles} bboxAcc=${acc | 0}`);
+})();
+</script>
+</body>
+</html>

