+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>WebAssembly bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre-wrap; }
+</style>
+</head>
+<body>
+<div id="status">wasm-bench: starting…</div>
+<script>
+// Exercises WebAssembly:
+//   - sync Module/Instance construction
+//   - async instantiate(bytes)
+//   - JS<->WASM boundary calls (i32)
+//   - indirect calls via call_indirect through an exported table
+//   - memory.grow and i32.load8_u from linear memory
+//   - repeated compile to exercise compiler tier-up
+//
+// Module (WAT):
+//   (module
+//     (memory (export "memory") 1)
+//     (table 2 funcref)
+//     (elem (i32.const 0) $add $sub)
+//     (func $add (export "add") (param i32 i32) (result i32)
+//       local.get 0 local.get 1 i32.add)
+//     (func $sub (export "sub") (param i32 i32) (result i32)
+//       local.get 0 local.get 1 i32.sub)
+//     (func (export "call") (param i32 i32 i32) (result i32)
+//       local.get 1 local.get 2 local.get 0
+//       call_indirect (type 0) (table 0))
+//     (func (export "sum_bytes") (param i32 i32) (result i32)
+//       (local i32 i32)
+//       local.get 1 local.set 2
+//       i32.const 0 local.set 3
+//       block
+//         loop
+//           local.get 2 i32.eqz br_if 1
+//           local.get 3
+//           local.get 0 local.get 2 i32.add
+//           i32.const 1 i32.sub
+//           i32.load8_u
+//           i32.add local.set 3
+//           local.get 2 i32.const 1 i32.sub local.set 2
+//           br 0
+//         end
+//       end
+//       local.get 3))
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const statusEl = document.getElementById("status");
+
+const WASM_BYTES = new Uint8Array([
+  // Magic + version
+  0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
+
+  // Type section (id=1, size=0x0e=14, count=2)
+  0x01, 0x0e, 0x02,
+    0x60, 0x02, 0x7f, 0x7f, 0x01, 0x7f,        // (i32,i32) -> i32
+    0x60, 0x03, 0x7f, 0x7f, 0x7f, 0x01, 0x7f,  // (i32,i32,i32) -> i32
+
+  // Function section (id=3, size=0x05, count=4, types [0,0,1,0])
+  0x03, 0x05, 0x04, 0x00, 0x00, 0x01, 0x00,
+
+  // Table section (id=4, size=0x04, count=1, funcref, min=2)
+  0x04, 0x04, 0x01, 0x70, 0x00, 0x02,
+
+  // Memory section (id=5, size=0x03, count=1, min=1)
+  0x05, 0x03, 0x01, 0x00, 0x01,
+
+  // Export section (id=7, size=0x29=41, count=5)
+  0x07, 0x29, 0x05,
+    0x06, 0x6d, 0x65, 0x6d, 0x6f, 0x72, 0x79, 0x02, 0x00,  // "memory" -> memory 0
+    0x03, 0x61, 0x64, 0x64, 0x00, 0x00,                    // "add" -> func 0
+    0x03, 0x73, 0x75, 0x62, 0x00, 0x01,                    // "sub" -> func 1
+    0x04, 0x63, 0x61, 0x6c, 0x6c, 0x00, 0x02,              // "call" -> func 2
+    0x09, 0x73, 0x75, 0x6d, 0x5f, 0x62, 0x79, 0x74, 0x65, 0x73, 0x00, 0x03,  // "sum_bytes" -> func 3
+
+  // Element section (id=9, size=0x08, count=1)
+  0x09, 0x08, 0x01,
+    0x00,              // active, table 0
+    0x41, 0x00, 0x0b,  // offset: i32.const 0
+    0x02, 0x00, 0x01,  // funcs [0, 1]
+
+  // Code section (id=10, size=0x52=82, count=4)
+  0x0a, 0x52, 0x04,
+
+    // body 0: add — size=0x07
+    0x07, 0x00, 0x20, 0x00, 0x20, 0x01, 0x6a, 0x0b,
+
+    // body 1: sub — size=0x07
+    0x07, 0x00, 0x20, 0x00, 0x20, 0x01, 0x6b, 0x0b,
+
+    // body 2: call_indirect — size=0x0b
+    0x0b, 0x00,
+      0x20, 0x01, 0x20, 0x02, 0x20, 0x00, 0x11, 0x00, 0x00,
+    0x0b,
+
+    // body 3: sum_bytes — size=0x34=52
+    0x34,
+      // locals: 2 x i32
+      0x02, 0x01, 0x7f, 0x01, 0x7f,
+      // code
+      0x20, 0x01, 0x21, 0x02,        // local.get 1; local.set 2
+      0x41, 0x00, 0x21, 0x03,        // i32.const 0; local.set 3
+      0x02, 0x40,                    // block
+        0x03, 0x40,                  // loop
+          0x20, 0x02, 0x45,          // local.get 2; i32.eqz
+          0x0d, 0x01,                // br_if 1 (exit block)
+          0x20, 0x03,                // local.get 3
+          0x20, 0x00,                // local.get 0 (ptr)
+          0x20, 0x02, 0x6a,          // local.get 2; i32.add
+          0x41, 0x01, 0x6b,          // i32.const 1; i32.sub
+          0x2d, 0x00, 0x00,          // i32.load8_u
+          0x6a,                      // i32.add
+          0x21, 0x03,                // local.set 3
+          0x20, 0x02,                // local.get 2
+          0x41, 0x01, 0x6b,          // i32.const 1; i32.sub
+          0x21, 0x02,                // local.set 2
+          0x0c, 0x00,                // br 0 (continue)
+        0x0b,                        // end loop
+      0x0b,                          // end block
+      0x20, 0x03,                    // local.get 3
+    0x0b,                            // end func
+]);
+
+function compileAndInstantiate() {
+  const module = new WebAssembly.Module(WASM_BYTES);
+  const instance = new WebAssembly.Instance(module, {});
+  return { module, instance };
+}
+
+(async function run() {
+  const start = now();
+
+  let base;
+  try {
+    base = compileAndInstantiate();
+  } catch (e) {
+    statusEl.textContent = "wasm-bench: compile failed — " + e.message;
+    console.error("[wasm] compile failed", e);
+    return;
+  }
+
+  const add = base.instance.exports.add;
+  const sub = base.instance.exports.sub;
+  const call = base.instance.exports.call;
+  const sumBytes = base.instance.exports.sum_bytes;
+  const memory = base.instance.exports.memory;
+
+  // Sanity: fill 4096 bytes with 7 → sum should be 28672.
+  const init = new Uint8Array(memory.buffer);
+  init.fill(7, 0, 4096);
+  const sanitySum = sumBytes(0, 4096) | 0;
+  if (sanitySum !== 28672) {
+    console.warn("[wasm] sum_bytes sanity check failed:", sanitySum);
+  }
+
+  // Async instantiate path (also exercises the streaming-ish code path).
+  let asyncAdd = add;
+  try {
+    const res = await WebAssembly.instantiate(WASM_BYTES);
+    asyncAdd = res.instance.exports.add;
+  } catch (e) {
+    console.warn("[wasm] async instantiate failed", e);
+  }
+
+  let syncCalls = 0;
+  let boundaryAcc = 0;
+  let indirectCalls = 0;
+  let grows = 0;
+  let compiles = 1;
+  let checksum = sanitySum;
+
+  while (now() - start < TIME_BUDGET) {
+    // Hot JS<->WASM boundary loop.
+    let s = 0;
+    for (let i = 0; i < 20000; i++) {
+      s = add(s, i) | 0;
+      s = asyncAdd(s, 1) | 0;
+      s = sub(s, 1) | 0;
+    }
+    syncCalls += 20000;
+    boundaryAcc = (boundaryAcc + s) | 0;
+
+    // Indirect call through exported table.
+    let acc = 0;
+    for (let i = 0; i < 5000; i++) {
+      acc = (acc + call(i & 1, i, 3)) | 0;
+    }
+    indirectCalls += 5000;
+
+    // Read linear memory through WASM loop.
+    checksum = sumBytes(0, 4096) | 0;
