+    if (grows < 16) {
+      try {
+        memory.grow(1);
+        grows++;
+      } catch (e) {
+        // Engine cap; recreate the instance.
+        try {
+          base = compileAndInstantiate();
+          compiles++;
+        } catch (e2) {
+          console.error("[wasm] re-instantiate failed", e2);
+          break;
+        }
+      }
+    }
+
+    // Periodic recompile to exercise compiler tiers.
+    if ((syncCalls % 200000) === 0) {
+      try {
+        const m = new WebAssembly.Module(WASM_BYTES);
+        WebAssembly.Module.exports(m);
+        compiles++;
+      } catch (e) {
+        console.error("[wasm] compile error", e);
+        break;
+      }
+    }
+
+    statusEl.textContent =
+      `wasm-bench: sync=${syncCalls} indirect=${indirectCalls} ` +
+      `grows=${grows} compiles=${compiles} checksum=${checksum} ` +
+      `elapsed=${(now() - start) | 0}ms`;
+  }
+
+  statusEl.textContent =
+    `wasm-bench: done — sync=${syncCalls} indirect=${indirectCalls} ` +
+    `grows=${grows} compiles=${compiles} checksum=${checksum} ` +
+    `(expected 28672)`;
+  console.log(
+    `[wasm] syncCalls=${syncCalls} indirect=${indirectCalls} ` +
+    `grows=${grows} compiles=${compiles} checksum=${checksum}`
+  );
+})();
+</script>
+</body>
+</html>

