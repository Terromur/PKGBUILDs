+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>IndexedDB bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre; }
+</style>
+</head>
+<body>
+<div id="status">idb-bench: starting…</div>
+<script>
+// Exercises IndexedDB: open/upgrade, batch put, cursor iteration via index,
+// batch get, deleteDatabase. Runs until TIME_BUDGET ms elapsed.
+const TIME_BUDGET = 1500;
+// Unique DB name per page load so a stale schema from a previous
+// profileserver run can never collide with this one.
+const DB_NAME = "pgo-idb-bench-" + Math.random().toString(36).slice(2);
+const STORE = "records";
+const N_PER_BATCH = 1000;
+
+const statusEl = document.getElementById("status");
+const now = () => performance.now();
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = e => {
+      const db = e.target.result;
+      if (!db.objectStoreNames.contains(STORE)) {
+        const store = db.createObjectStore(STORE, { keyPath: "id" });
+        store.createIndex("group", "group", { unique: false });
+      }
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+    req.onblocked = () => reject(new Error("open blocked"));
+  });
+}
+
+function txDone(tx) {
+  return new Promise((resolve, reject) => {
+    tx.oncomplete = () => resolve();
+    tx.onerror = () => reject(tx.error);
+    tx.onabort = () => reject(tx.error);
+  });
+}
+
+async function batch(db, base) {
+  // Write batch
+  const tx = db.transaction(STORE, "readwrite");
+  const store = tx.objectStore(STORE);
+  for (let i = 0; i < N_PER_BATCH; i++) {
+    store.put({
+      id: base + i,
+      group: (base + i) % 100,
+      payload: "x".repeat(64),
+      n: i,
+    });
+  }
+  await txDone(tx);
+
+  // Read batch via index cursor
+  const readTx = db.transaction(STORE, "readonly");
+  const idx = readTx.objectStore(STORE).index("group");
+  let count = 0;
+  await new Promise((resolve, reject) => {
+    const cur = idx.openCursor(IDBKeyRange.bound(0, 50));
+    cur.onsuccess = e => {
+      const c = e.target.result;
+      if (c) { count += c.value.n; c.continue(); }
+      else resolve();
+    };
+    cur.onerror = () => reject(cur.error);
+  });
+  await txDone(readTx);
+  return count;
+}
+
+async function deleteDb() {
+  return new Promise(resolve => {
+    const d = indexedDB.deleteDatabase(DB_NAME);
+    // Only resolve on success/error — never on blocked, so we don't leave
+    // the DB in a half-deleted state for the next run.
+    d.onsuccess = () => resolve("ok");
+    d.onerror = () => resolve("error");
+    // Give up after 2 s if something keeps it blocked.
+    setTimeout(() => resolve("blocked-timeout"), 2000);
+  });
+}
+
+(async function run() {
+  const start = now();
+  let db;
+  try {
+    db = await openDb();
+  } catch (e) {
+    statusEl.textContent = "idb-bench: open failed — " + e.message;
+    console.error("[idb] open failed", e);
+    return;
+  }
+
+  let base = 0;
+  let batches = 0;
+  while (now() - start < TIME_BUDGET) {
+    try {
+      await batch(db, base);
+      base += N_PER_BATCH;
+      batches++;
+      statusEl.textContent =
+        `idb-bench: batches=${batches} records=${base} elapsed=${(now() - start) | 0}ms`;
+    } catch (e) {
+      console.error("[idb] batch error", e);
+      break;
+    }
+  }
+
+  db.close();
+  const delResult = await deleteDb();
+  statusEl.textContent =
+    `idb-bench: done — batches=${batches} records=${base} delete=${delResult}`;
+  console.log(`[idb] batches=${batches} records=${base} delete=${delResult}`);
+})();
+</script>
+</body>
+</html>

