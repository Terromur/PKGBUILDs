+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>CSS layout bench</title>
+<style>
+  body { margin: 0; font-family: sans-serif; }
+  #stage { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
+  .grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }
+  .flex { display: flex; flex-wrap: wrap; gap: 4px; }
+  .box {
+    background: linear-gradient(135deg, #4d6bfe, #8ba0ff);
+    color: white;
+    padding: 4px;
+    border-radius: 4px;
+    will-change: transform;
+  }
+  .cell { min-width: 20px; min-height: 20px; }
+</style>
+</head>
+<body>
+<div id="stage"></div>
+<script>
+// Exercises layout engine: Grid + Flex reflow, style recalc, transform
+// compositing, :nth-child selectors, media-query-ish calc, forced sync layout.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const stage = document.getElementById("stage");
+
+function buildScene(seed) {
+  const frag = document.createDocumentFragment();
+  const grid = document.createElement("div");
+  grid.className = "grid";
+  for (let i = 0; i < 64; i++) {
+    const d = document.createElement("div");
+    d.className = "box cell";
+    d.textContent = String((seed + i) % 1000);
+    d.style.transform = `rotate(${(seed + i) % 360}deg) scale(${0.9 + (i % 5) * 0.02})`;
+    frag.appendChild(d);
+    grid.appendChild(d);
+  }
+  const flex = document.createElement("div");
+  flex.className = "flex";
+  for (let i = 0; i < 96; i++) {
+    const d = document.createElement("div");
+    d.className = "box cell";
+    d.textContent = String((seed * 3 + i) % 777);
+    d.style.transform = `translate(${(i % 7) * 3}px, ${(i % 5) * 3}px)`;
+    frag.appendChild(d);
+    flex.appendChild(d);
+  }
+  return { frag, grid, flex };
+}
+
+(function run() {
+  const start = now();
+  let cycles = 0;
+  while (now() - start < TIME_BUDGET) {
+    const { frag, grid, flex } = buildScene(cycles);
+    stage.innerHTML = "";
+    stage.appendChild(frag);
+    stage.appendChild(grid);
+    stage.appendChild(flex);
+    // Force layout & paint.
+    const h = stage.getBoundingClientRect().height;
+    void stage.offsetHeight;
+    // Query selectors exercise selector matching.
+    const boxes = stage.querySelectorAll(".box");
+    let acc = 0;
+    for (let i = 0; i < boxes.length; i += 7) {
+      acc += boxes[i].offsetWidth;
+    }
+    // Mutate style to force another recalc.
+    for (let i = 0; i < boxes.length; i += 13) {
+      boxes[i].style.background = `hsl(${(cycles + i) % 360}, 70%, 60%)`;
+      boxes[i].style.transform = `translateX(${(cycles + i) % 20}px)`;
+    }
+    void stage.offsetHeight;
+    if (h === 0) console.log("[css] unexpected zero height");
+    cycles++;
+  }
+  console.log(`[css] cycles=${cycles}`);
+})();
+</script>
+</body>
+</html>

