+<!DOCTYPE html>
+<html>
+<head>
+<meta charset="utf-8">
+<title>Web Crypto bench</title>
+<style>
+  body { font: 13px system-ui, sans-serif; margin: 8px; color: #333; }
+  #status { font-variant-numeric: tabular-nums; white-space: pre-wrap; }
+</style>
+</head>
+<body>
+<div id="status">webcrypto: starting…</div>
+<script>
+// Exercises Web Crypto:
+//   - AES-GCM encrypt/decrypt
+//   - SHA-256 / SHA-384 / SHA-512 digest
+//   - PBKDF2 key derivation
+//   - ECDSA P-256 keygen / sign / verify
+//   - RSA-OAEP 2048 keygen / encrypt / decrypt
+//
+// Each op-type is wrapped in try/catch so one failing algorithm cannot
+// take down the whole run, and the top-level has an explicit .catch()
+// so unhandled rejections never silently leave a blank page.
+const TIME_BUDGET = 1500;
+const now = () => performance.now();
+const statusEl = document.getElementById("status");
+
+function bytes(n) {
+  const a = new Uint8Array(n);
+  crypto.getRandomValues(a);
+  return a;
+}
+
+async function aesGcmRounds(aesKey, iv, pt) {
+  const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, aesKey, pt);
+  await crypto.subtle.decrypt({ name: "AES-GCM", iv }, aesKey, ct);
+}
+
+async function shaRounds(data) {
+  await crypto.subtle.digest("SHA-256", data);
+  await crypto.subtle.digest("SHA-384", data);
+  await crypto.subtle.digest("SHA-512", data);
+}
+
+async function hmacRounds(key, data) {
+  const sig = await crypto.subtle.sign("HMAC", key, data);
+  await crypto.subtle.verify("HMAC", key, sig, data);
+}
+
+async function pbkdf2Rounds(baseKey, salt) {
+  await crypto.subtle.deriveBits(
+    { name: "PBKDF2", salt, iterations: 5000, hash: "SHA-256" },
+    baseKey, 256
+  );
+}
+
+async function ecdsaRounds(msg) {
+  const kp = await crypto.subtle.generateKey(
+    { name: "ECDSA", namedCurve: "P-256" }, false, ["sign", "verify"]
+  );
+  const sig = await crypto.subtle.sign(
+    { name: "ECDSA", hash: "SHA-256" }, kp.privateKey, msg
+  );
+  await crypto.subtle.verify(
+    { name: "ECDSA", hash: "SHA-256" }, kp.publicKey, sig, msg
+  );
+}
+
+async function rsaRounds(pt) {
+  const kp = await crypto.subtle.generateKey(
+    {
+      name: "RSA-OAEP",
+      modulusLength: 2048,
+      publicExponent: new Uint8Array([1, 0, 1]),
+      hash: "SHA-256",
+    },
+    false,
+    ["encrypt", "decrypt"]
+  );
+  const ct = await crypto.subtle.encrypt({ name: "RSA-OAEP" }, kp.publicKey, pt);
+  await crypto.subtle.decrypt({ name: "RSA-OAEP" }, kp.privateKey, ct);
+}
+
+async function run() {
+  const start = now();
+
+  if (!(window.crypto && crypto.subtle && crypto.getRandomValues)) {
+    statusEl.textContent = "webcrypto: crypto.subtle unavailable in this context";
+    console.warn("[webcrypto] crypto.subtle unavailable");
+    return;
+  }
+
+  // Prepare shared inputs once.
+  const aesKey = await crypto.subtle.generateKey(
+    { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]
+  );
+  const hmacKey = await crypto.subtle.generateKey(
+    { name: "HMAC", hash: "SHA-256", length: 256 }, false, ["sign", "verify"]
+  );
+  const pbkdf2Key = await crypto.subtle.importKey(
+    "raw",
+    new TextEncoder().encode("correct-horse-battery-staple"),
+    "PBKDF2",
+    false,
+    ["deriveBits"]
+  );
+  const iv = bytes(12);
+  const pt4k = bytes(4096);
+  const pt128 = bytes(128);
+  const salt = bytes(16);
+
+  let aesN = 0, shaN = 0, hmacN = 0, pbkdfN = 0, ecdsaN = 0, rsaN = 0;
+  let aesErr = 0, shaErr = 0, hmacErr = 0, pbkdfErr = 0, ecdsaErr = 0, rsaErr = 0;
+
+  // RSA keygen is slow; cap it separately so the loop doesn't stall.
+  const RSA_MAX = 20;
+
+  while (now() - start < TIME_BUDGET) {
+    // Fast ops first — they dominate the sample count.
+    try { await aesGcmRounds(aesKey, iv, pt4k); aesN++; } catch (e) { aesErr++; }
+
+    try { await shaRounds(pt4k); shaN++; } catch (e) { shaErr++; }
+
+    try { await hmacRounds(hmacKey, pt4k); hmacN++; } catch (e) { hmacErr++; }
+
+    // PBKDF2 with 5000 iterations is moderately expensive.
+    try { await pbkdf2Rounds(pbkdf2Key, salt); pbkdfN++; } catch (e) { pbkdfErr++; }
+
+    // ECDSA keygen is ~1ms, but sign/verify dominate.
+    try { await ecdsaRounds(pt128); ecdsaN++; } catch (e) { ecdsaErr++; }
+
+    // RSA keygen is the slowest; cap it.
+    if (rsaN < RSA_MAX && now() - start < TIME_BUDGET) {
+      try { await rsaRounds(pt128); rsaN++; } catch (e) { rsaErr++; }
+    }
+
+    // Update status every couple of loop iterations.
+    if (((aesN + shaN + hmacN) & 7) === 0) {
+      statusEl.textContent =
+        `webcrypto: aes=${aesN} sha=${shaN} hmac=${hmacN} ` +
+        `pbkdf2=${pbkdfN} ecdsa=${ecdsaN} rsa=${rsaN} ` +
+        `elapsed=${(now() - start) | 0}ms`;
+    }
+  }
+
+  const summary =
+    `[webcrypto] aes=${aesN} sha=${shaN} hmac=${hmacN} ` +
+    `pbkdf2=${pbkdfN} ecdsa=${ecdsaN} rsa=${rsaN} | ` +
+    `errors: aes=${aesErr} sha=${shaErr} hmac=${hmacErr} ` +
+    `pbkdf2=${pbkdfErr} ecdsa=${ecdsaErr} rsa=${rsaErr}`;
+  statusEl.textContent = "webcrypto: done — " + summary;
+  console.log(summary);
+}
+
+run().catch(e => {
+  statusEl.textContent = "webcrypto: fatal — " + (e && e.message ? e.message : e);
+  console.error("[webcrypto] fatal", e);
+});
+</script>
+</body>
+</html>

