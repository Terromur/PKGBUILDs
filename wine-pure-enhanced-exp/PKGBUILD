pkgver() {
  git -C wine describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^wine.//;s/^v//;s/\.rc/rc/'
}

prepare() {
  # Get rid of old build dirs
  rm -rf "$pkgname-build"
  mkdir "$pkgname-build"

  cd wine

  # apply wine-staging patchset
  ../wine-staging/staging/patchinstall.py --backend=git-apply --all

  # Use native Visual C++ DLLs, fix Windows product version
  patch -Np1 -i "${srcdir}/0001-HACK-wine.inf-Add-native-builtin-overrides-for-msvcr.patch"
  patch -Np1 -i "${srcdir}/0002-wine.inf-Set-a-valid-Win10-ProductId.patch"
  patch -Np1 -i "${srcdir}/0003-wineboot-On-prefix-upgrade-update-win10-build-number.patch"
  patch -Np1 -i "${srcdir}/0004-wineboot-Generate-better-DigitalProductId.patch"
  patch -Np1 -i "${srcdir}/0005-wineboot-Load-root-certificates-on-prefix-update.patch"

  # Disable optimization of some functions on Clang, as this breaks some games
  # TODO: Understand root causes and check latest Clang
  # Fixes: Hogwarts Legacy by Empress
  patch -Np1 -i "${srcdir}/Disable-optimization-of-some-functions.patch"

  # Add tweaks tab page in winecfg
  patch -Np1 -i "${srcdir}/winecfg-Add-tweaks-tab-page.patch"

  # Patch from Proton. Works only if WINE_LARGE_ADDRESS_AWARE environment
  # variable is specified.
  patch -Np1 -i "${srcdir}/ntdll-loader-add-support-for-overriding-IMAGE_FILE_L.patch"

  # Fix black windows in some launchers when using winewayland
  patch -Np1 -i "${srcdir}/Add-workarounds-for-game-launchers.patch"

  # Fixes anti-cheat bypass for Mihoyo games
  # Patch by @NelloKudo
  patch -Np1 -i "${srcdir}/0001-HACK-ws2_32-Block-first-internet-connection-for-some.patch"

  # Clang specific fix
  patch -Np1 -i "${srcdir}/Configure-Enforce-4-byte-stack-alignment-on-clang-for-PE-builds.patch"

  # ntdll: Never use CLOCK_REALTIME_COARSE
  # https://gitlab.winehq.org/wine/wine/-/merge_requests/10108
  patch -Np1 -i "${srcdir}/10108.patch"

  # Futex optimizations
  # https://gitlab.winehq.org/wine/wine/-/merge_requests/10829
  patch -Np1 -i "${srcdir}/10829.patch"

  # kernelbase: Handle misaligned stack in OpenThread
  # https://gitlab.winehq.org/wine/wine/-/merge_requests/11069
  patch -Np1 -i "${srcdir}/kernelbase-Handle-misaligned-stack-in-OpenThread.patch"
  
  # winewayland fixes & improvements from Proton-EM
  patch -Np1 -i "${srcdir}/proton-em-winewayland.patch"
  
  # Other patches
  patch -Np1 -i "${srcdir}/joystick.patch"
  patch -Np1 -i "${srcdir}/no-winemenubuilder.patch"
  patch -Np1 -i "${srcdir}/access-alignment-property.patch"
  patch -Np1 -i "${srcdir}/kernel32-tests-expand-locking-coverage.patch"
  patch -Np1 -i "${srcdir}/kernelbase-signal-unlockfileex-events.patch"
  patch -Np1 -i "${srcdir}/win32u-map-oem-charset.patch"
  patch -Np1 -i "${srcdir}/wineserver-close-released-lock-fds.patch"
  patch -Np1 -i "${srcdir}/wine-msvcrt-binary-ccs-utf8-bom.patch"
  patch -Np1 -i "${srcdir}/wine-msvcrt-narrow-open-createfilea.patch"
  patch -Np1 -i "${srcdir}/wine-pipe-file-position.patch"
  patch -Np1 -i "${srcdir}/0006-comdlg32-use-XDG-Desktop-Portal-for-native-file-dial.patch"
  patch -Np1 -i "${srcdir}/0007-comdlg32-fix-portal-dialog-compatibility-and-respons.patch"
  patch -Np1 -i "${srcdir}/0008-comdlg32-add-wow64-unix-call-table-for-32-bit.patch"
  patch -Np1 -i "${srcdir}/0001-ntdll-alertable-sleep-fast-path.patch"
  patch -Np1 -i "${srcdir}/0007-msi-rewrite-all-tables-on-long-strref.patch"
  patch -Np1 -i "${srcdir}/0008-wined3d-only-map-host-visible-bo.patch"
  patch -Np1 -i "${srcdir}/10892.patch"
  patch -Np1 -i "${srcdir}/10805.patch"
  patch -Np1 -i "${srcdir}/10547.patch"
  patch -Np1 -i "${srcdir}/10471.patch"
  patch -Np1 -i "${srcdir}/9640.patch"
  patch -Np1 -i "${srcdir}/8484.patch"
  patch -Np1 -i "${srcdir}/4908.patch"

  ./dlls/winevulkan/make_vulkan
  ./tools/make_requests
  ./tools/make_specfiles
  
        local wine_osu_patches_dir="${srcdir}/wine-osu-patches"
if [ -d "${wine_osu_patches_dir}" ]; then
  while IFS= read -r -d '' patch; do
    msg2 "Applying wine-osu-patches patches: ${p#${wine_osu_patches_dir}/}"
    patch -Np1 < "$patch"
  done < <(find "${wine_osu_patches_dir}" \
    -type f \
    -name "*.patch" \
        -not -path "${wine_osu_patches_dir}/0003-pending-mrs-and-backports/*" \
        -not -path "${wine_osu_patches_dir}/0003-build-fix-undebug-optimize/0005-configure-Enforce-4-byte-stack-alignment-on-clang-fo.patch" \
        -not -path "${wine_osu_patches_dir}/0003-build-fix-undebug-optimize/0007-include-Prefer-builtin-atomics.patch" \
        -not -path "${wine_osu_patches_dir}/0004-proton-fsync/*" \
        -not -path "${wine_osu_patches_dir}/0005-windowing-system-integration/0001-misc/0013-winex11.drv-Do-not-enable-disable-XInput2-when-clipp.patch" \
        -not -path "${wine_osu_patches_dir}/0005-windowing-system-integration/0001-misc/0014-winecfg-Add-a-checkbox-to-enable-virtual-desktop-tas.patch" \
        -not -path "${wine_osu_patches_dir}/0005-windowing-system-integration/0002-proton/0008-winex11.drv-Only-process-raw-input-in-default-winsta.patch" \
        -not -path "${wine_osu_patches_dir}/0006-audio/0005-alsa-pulse-mmdevapi-Support-custom-period-and-buffer-sizes.patch" \
        -not -path "${wine_osu_patches_dir}/0006-audio/0008-pulse-mmdevapi-Some-simplifications-and-stability-im.patch" \
        -not -path "${wine_osu_patches_dir}/0006-audio/0010-winepulse-Stop-forcing-period-to-twice-the-minimum-s.patch" \
        -not -path "${wine_osu_patches_dir}/0007-proton-additions/0013-server-user32-Backport-more-raw-input-changes-from-P.patch" \
        -not -path "${wine_osu_patches_dir}/0008-winewayland-additions/*" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0009-win32u-Add-WINE_DISABLE_IME.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0016-HACK-proton-server-Close-desktop-immediately-when-la.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0036-winex11-Uninit-winattrs-fix.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0043-winex11-Custom-frame-limiter-for-OpenGL.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0046-winex11-winewayland-Add-an-opt-in-absolute-tablet-in.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0014-appwiz-Add-env.-vars-to-skip-mono-gecko-installation.patch" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/0042-server-rename-debug_level-to-_debug_level-to-hint-br.patch" \
        -print0 | sort -z)
fi  
  
          local proton_patches_dir="${srcdir}/proton-ge-custom/patches"
if [ -d "${proton_patches_dir}" ]; then
  while IFS= read -r -d '' patch; do
    msg2 "Applying proton-ge-custom patches: ${patch#${proton_patches_dir}/}"
    patch -Np1 < "$patch"
  done < <(find "${proton_patches_dir}" \
    -type f \
    -name "*.patch" \
        -not -path "${proton_patches_dir}/discordrpc/*" \
        -not -path "${proton_patches_dir}/dxvk/*" \
        -not -path "${proton_patches_dir}/game-patches/layered-overlay-wine.patch" \
        -not -path "${proton_patches_dir}/game-patches/maplestory-kernelbase-charprev-null.patch" \
        -not -path "${proton_patches_dir}/ge-video-rework/*" \
        -not -path "${proton_patches_dir}/lsteamclient/*" \
        -not -path "${proton_patches_dir}/pipewire/*" \
        -not -path "${proton_patches_dir}/proton-ds5-haptic/*" \
        -not -path "${proton_patches_dir}/proton/0001-De-steamify-proton-s-WINE-so-it-can-be-used-as-a-sta.patch" \
        -not -path "${proton_patches_dir}/proton/winealsa-override-channel-count.patch" \
        -not -path "${proton_patches_dir}/proton/0001-HACK-kernelbase-allow-overriding-dlls-for-DLSS-XeSS-.patch" \
        -not -path "${proton_patches_dir}/proton/0001-fshack-Implement-AMD-FSR-upscaler-for-fullscreen-hac.patch" \
        -not -path "${proton_patches_dir}/proton/0001-win32u-Implement-NtGdiDdDDIQueryAdapterInfo-cases.patch" \
        -not -path "${proton_patches_dir}/proton/0001-win32u-add-env-switch-to-disable-wm-decorations.patch" \
        -not -path "${proton_patches_dir}/proton/83-nv_low_latency_wine.patch" \
        -not -path "${proton_patches_dir}/proton/0002-HACK-ntdll-add-optiscaler-inection-hack.patch" \
        -not -path "${proton_patches_dir}/proton/wine_host_block_envvar.patch" \
        -not -path "${proton_patches_dir}/proton/winex11-mutter-cinnamon.patch" \
        -not -path "${proton_patches_dir}/protonfixes/*" \
        -not -path "${proton_patches_dir}/vkd3d-proton/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/disabled/0210-winedmo-Handle-demuxer-URLs-without-an-extension.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/disabled/wine-wayland-offscreen-rendering/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/em-fixups/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0001-decouple-wineopenxr-from-steamvr-and-integrate-it-in.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0001-server-Dynamically-relocate-.exes-by-default-too.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0002-ntdll-allow-disabling-executable-ASLR.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/icuuc-icuin-forwarder-dlls.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-prefer-native-version-resource-heuristics.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/secur32-fallback-without-no-shuffle-extensions.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0009-HACK-kernel32-Spoof-GetProcAddress-of-KiUserApcDispa.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-reserve-top-down-space-for-large-address-aware-wow64.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-remove-redundant-packed-split-lock.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/winex11-use-x11-drawables-for-steam-opengl-overlay.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/crypt32-pfx-record-machine-keyset-in-prov-info.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/crypt32-pfx-use-the-container-key-spec.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-keep-builtin-amd-ags-ahead-of-version-heuristic.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/comctl32_animate_avi/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/mmsystem.dll16-MIDIHDR_Refcount/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/windowscodecs-TIFF_Support/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/winex11-Fixed-scancodes/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/winex11-ime-check-thread-data/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-wayland/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wineland-child-rendering/*" \
        -not -path "${proton_patches_dir}/wineopenxr/*" \
        -print0 | sort -z)
fi
  
            local spritz_patches_dir="${srcdir}/spritz-wine/patches"
if [ -d "${spritz_patches_dir}" ]; then
  while IFS= read -r -d '' patch; do
    msg2 "Applying spritz patches: ${patch#${spritz_patches_dir}/}"
    patch -Np1 < "$patch"
  done < <(find "${spritz_patches_dir}" \
    -type f \
    -name "*.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0002-HACK-ws2_32-Block-first-internet-connection-for-some.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0007-loader-Copy-arial.ttf-to-fonts.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0006-HACK-winex11-Make-WM-focus-the-window-by-default.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0008-winex11-Ignore-XI_BadDevice-errors-on-X_OpenDevice-w.patch" \
        -not -path "${spritz_patches_dir}/0002-proton-controllers/0003-winebus-Disable-Hidraw-by-default-add-log-message.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0001-ntdll-loader-add-support-for-overriding-IMAGE_FILE_L.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0003-user32-Update-system-colors.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0004-comctl32-Remove-rounded-edges-from-tabs.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0005-user32-Draw-buttons-as-flat-by-default.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0006-comctl32-Don-t-use-a-dotty-pen-for-treeview.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0007-user32-Draw-focus-rects-in-solid-blue.patch" \
        -not -path "${spritz_patches_dir}/0004-proton-fsync/*" \
        -not -path "${spritz_patches_dir}/0006-misc/0004-ntdll-Never-use-CLOCK_REALTIME_COARSE.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0009-ntoskrnl.exe-Add-stub-for-KeGetCurrentIrql.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0001-HACK-winex11.drv-Workaround-focusing-out-of-exclusiv.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0010-winex11-Keep-track-of-the-window-manager-name.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0011-win32u-Add-a-new-driver-entry-to-check-window-manage.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0012-winex11-Add-Muffin-Cinnamon-to-Mutter-detection.patch" \
        -not -path "${spritz_patches_dir}/0007-winewayland/*" \
        -not -path "${spritz_patches_dir}/0008-pending-MR/10829-Futex-optimizations/*" \
        -not -path "${spritz_patches_dir}/0008-pending-MR/11339-winegstreamer-wma-decoder-Implement-Get-Input-Output-CurrentType/*" \
