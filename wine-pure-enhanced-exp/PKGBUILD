        -print0 | sort -z)
fi

    local starcitizen_lug_dir="${srcdir}/patches"
    if [ -d "${starcitizen_lug_dir}" ]; then
      while IFS= read -r -d '' patch; do
        msg2 "Applying starcitizen_lug patches: ${p#${starcitizen_lug_dir}/}"
        patch -Np1 < "$patch"
      done < <(find "${starcitizen_lug_dir}" \
        -type f \
        -name "*.patch" \
        -not -path "${starcitizen_lug_dir}/mesa/*" \
        -not -path "${starcitizen_lug_dir}/proton/*" \
        -not -path "${starcitizen_lug_dir}/vkd3d-proton/*" \
        -not -path "${starcitizen_lug_dir}/xorg/*" \
        -not -path "${starcitizen_lug_dir}/wine/10.2+_eac_fix.patch" \
        -not -path "${starcitizen_lug_dir}/wine/printkey_x11-staging.patch" \
        -not -path "${starcitizen_lug_dir}/wine/eac_60101_timeout.patch" \
        -not -path "${starcitizen_lug_dir}/wine/9196_process_idle_event_client_side.patch" \
        -not -path "${starcitizen_lug_dir}/wine/append_cmd_override.patch" \
        -not -path "${starcitizen_lug_dir}/wine/hidewineexports.patch" \
        -not -path "${starcitizen_lug_dir}/wine/reg_show_wine.patch" \
        -not -path "${starcitizen_lug_dir}/wine/revert-egl-default.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winefacewarehacks-minimal.patch" \
        -not -path "${starcitizen_lug_dir}/wine/wineland_pointer_warping.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-no-enter-move-if-relative.patch" \
        -not -path "${starcitizen_lug_dir}/wine/real_path.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0001-wineopenxr_add.patch" \
