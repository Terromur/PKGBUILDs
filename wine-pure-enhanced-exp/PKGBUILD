        -not -path "${starcitizen_lug_dir}/wine/0079-HACK-winewayland-add-support-for-picking-primary-mon.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0088-fixup-HACK-winewayland-add-support-for-picking-prima.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-fullscreen-idle-inhibit.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-guess-primary-output.patch" \
        -print0 | sort -z)
    fi

        local gwine_patches_dir="${srcdir}/gwine"
if [ -d "${gwine_patches_dir}" ]; then
  while IFS= read -r -d '' patch; do
    msg2 "Applying gwine-patches patches: ${p#${gwine_patches_dir}/}"
    patch -Np1 < "$patch"
  done < <(find "${gwine_patches_dir}" \
    -type f \
    -name "*.patch" \
        -not -path "${gwine_patches_dir}/cpuid_fault_handler.mypatch" \
        -not -path "${gwine_patches_dir}/disable_mediaconv_fallback.mypatch" \
        -not -path "${gwine_patches_dir}/faketime.mypatch" \
        -not -path "${gwine_patches_dir}/mpeg4_m4s2_decoder_fix.mypatch" \
        -not -path "${gwine_patches_dir}/use_real_username.mypatch" \
        -not -path "${gwine_patches_dir}/winewayland-keep-toplevel-for-client-surfaces.mypatch" \
        -not -path "${gwine_patches_dir}/wmadec_getcurrenttype.mypatch" \
        -not -path "${gwine_patches_dir}/no_exe_executable_bit.mypatch" \
        -print0 | sort -z)
fi
  autoreconf -f
}

build() {
  # Apply flags for cross-compilation
    export CC="clang" CXX="clang++"
    export AR=llvm-ar
    export RANLIB=llvm-ranlib
    export NM=llvm-nm
    local _base_flags="-march=native -mtune=native -O2 -pipe -fno-stack-protector -fno-stack-check -fno-math-errno -fno-trapping-math -fno-semantic-interposition -fcf-protection=none -mharden-sls=none -fno-ident -mllvm -adce-remove-loops -mllvm -enable-ext-tsp-block-placement=1 -mllvm -enable-dfa-jump-thread"
    export CFLAGS="${_base_flags} -D_FILE_OFFSET_BITS=64 -D_FORTIFY_SOURCE=0"
    export CXXFLAGS="${CFLAGS} -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    export CROSSCFLAGS="${_base_flags} -D_FORTIFY_SOURCE=0" 
    export CROSSCXXFLAGS="${CROSSCFLAGS} -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    export CROSSLDFLAGS="-Wl,/FILEALIGN:4096,/INCREMENTAL:NO,/LTCG,/OPT:REF,/OPT:ICF=3"
    export LDFLAGS="-fuse-ld=lld -flto=auto -O3 -Wl,--lto-O3 -Wl,--lto-CGO3 -Wl,--hash-style=gnu -Wl,--as-needed -Wl,-Bsymbolic-functions -Wl,-z,pack-relative-relocs -Wl,--strip-all -Wl,--icf=safe -Wl,--build-id=none -Wl,-z,norelro"

  cd "$pkgname-build"
  ../wine/configure \
    --disable-tests \
    --disable-win16 \
    --prefix=/usr \
    --libdir=/usr/lib \
    --with-x \
    --with-wayland \
    --with-gstreamer \
    --with-ffmpeg \
    --without-oss \
    --without-sane \
    --without-v4l2 \
    --without-cups \
    --without-gphoto \
    --without-xinerama \
    --without-pcsclite \
    --without-xxf86vm \
    --without-pcap \
    --without-ldap \
    --without-capi \
    --without-gsm \
    --without-krb5 \
    --with-mingw=clang \
    --enable-archs=x86_64,i386

  make
}

package() {
  cd "$pkgname-build"
  make prefix="$pkgdir/usr" \
    libdir="$pkgdir/usr/lib" \
    dlldir="$pkgdir/usr/lib/wine" install

  # Symlink for comptability with older scripts such as winetricks/setup_dxvk
  ln -sf /usr/bin/wine "$pkgdir"/usr/bin/wine64

  # Strip Windows binaries
  i686-w64-mingw32-strip --strip-debug "$pkgdir"/usr/lib/wine/i386-windows/*.dll
  x86_64-w64-mingw32-strip --strip-debug "$pkgdir"/usr/lib/wine/x86_64-windows/*.dll

  # Font aliasing settings for Win32 applications
  install -d "$pkgdir"/usr/share/fontconfig/conf.{avail,default}
  install -m644 "$srcdir/30-win32-aliases.conf" "$pkgdir/usr/share/fontconfig/conf.avail"
  ln -s ../conf.avail/30-win32-aliases.conf "$pkgdir/usr/share/fontconfig/conf.default/30-win32-aliases.conf"
  install -Dm 644 "$srcdir/wine-binfmt.conf" "$pkgdir/usr/lib/binfmt.d/wine.conf"

  # NTSync additions
  echo "ntsync" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/wine-pure.conf"
}

