# Maintainer: Terromur <terromuroz@proton.me>

pkgname=dxvk-low-latency-avx
pkgver=3.0.2
pkgrel=1
pkgdesc="A Vulkan-based compatibility layer for Direct3D 9/10/11 which allows running 3D applications on Linux using Wine. Windows DLL version)"
arch=('x86_64')
url="https://github.com/netborg-afps/dxvk-low-latency"
license=('zlib/libpng')
depends=('vulkan-icd-loader')
provides=('dxvk' 'd9vk' "dxvk=$pkgver")
conflicts=('d9vk'  "dxvk" 'dxvk-bin' "dxvk-pure-git")
makedepends=('ninja' 'meson>=0.43' 'glslang' 'clang' 'lld' 'llvm' 'git' 'mingw-w64-gcc')
options=(!strip !buildflags staticlibs)
source=(
    "git+https://github.com/netborg-afps/dxvk-low-latency"
    "git+https://github.com/Joshua-Ashton/mingw-directx-headers.git"
    "git+https://github.com/KhronosGroup/Vulkan-Headers.git"
    "git+https://github.com/KhronosGroup/SPIRV-Headers.git"
    "dxvk-extraopts.patch"
    "5367.patch"
    "Allow-build-with-AVX-when-using-Clang.patch"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    '83b240fdfff44b27c80b357055f405233c98e763310c2d1a001cd1b4d51d3aed'
    '4a12f6ced1bbcd05eee0a85e364e1730db8b1da543f4a049c6a3f85aac9fe561'
    'b2ad28c672da301ed8d90b36a37c71f722438e3daa565bcce9115306a1d37016'
)

pkgver() {
    cd dxvk-low-latency
    git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/v//g'
}

prepare() {
    cd dxvk-low-latency

    git remote set-url origin https://github.com/doitsujin/dxvk.git
    git submodule update --init --filter=tree:0 --recursive

    # Use Clang to build DXVK
    patch -p1 -i "$srcdir"/5367.patch
    patch -p1 -i "$srcdir"/Allow-build-with-AVX-when-using-Clang.patch

    # Patch to passthrough compiler flags (thanks @loathingkernel)
    patch -p1 -i "$srcdir"/dxvk-extraopts.patch

    local base_cflags="-march=native -mtune=native -O3 -funsafe-math-optimizations -fomit-frame-pointer -fno-ident -fno-stack-protector -fno-math-errno -fno-trapping-math -fcf-protection=none -mharden-sls=none -mllvm -adce-remove-loops -mllvm -enable-ext-tsp-block-placement=1 -mllvm -enable-dfa-jump-thread -D_FORTIFY_SOURCE=0"
    local cflags_64="${base_cflags} -D_FILE_OFFSET_BITS=64"
    local cxxflags_64="${base_cflags} -D_FILE_OFFSET_BITS=64 -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    local cflags_32="${base_cflags}"
    local cxxflags_32="${base_cflags} -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    local ldflags="-Wl,-O3 -Wl,--as-needed,--strip-all -Wl,--lto-O3 -Wl,--lto-CGO3 -flto -Wl,--file-alignment=4096 -latomic"

    sed -i build-win32-clang.txt \
        -e "s|@CARGS@|'${cflags_32// /\',\'}'|g" \
        -e "s|@CXXARGS@|'${cxxflags_32// /\',\'}'|g" \
        -e "s|@LDARGS@|'${ldflags// /\',\'}'|g"

    sed -i build-win64-clang.txt \
        -e "s|@CARGS@|'${cflags_64// /\',\'}'|g" \
        -e "s|@CXXARGS@|'${cxxflags_64// /\',\'}'|g" \
        -e "s|@LDARGS@|'${ldflags// /\',\'}'|g"
}

build() {
    meson setup dxvk-low-latency "build/x64" \
        --cross-file dxvk-low-latency/build-win64-clang.txt \
        --prefix "/usr/share/dxvk/x64" \
        --bindir "" --libdir "" \
        --buildtype "release" \
        --strip
    ninja -C "build/x64" -v

    meson setup dxvk-low-latency "build/x32" \
        --cross-file dxvk-low-latency/build-win32-clang.txt \
        --prefix "/usr/share/dxvk/x32" \
        --bindir "" --libdir "" \
        --buildtype "release" \
        --strip
    ninja -C "build/x32" -v
}

package() {
     DESTDIR="$pkgdir" ninja -C "build/x32" install
     DESTDIR="$pkgdir" ninja -C "build/x64" install
     install -Dm 644 -t "$pkgdir/usr/share/licenses/$pkgname" dxvk-low-latency/LICENSE
}
