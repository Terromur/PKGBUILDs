# Contributor: Marcell Meszaros < marcell.meszaros AT runbox.eu >
# Contributor: Emmanuel Gil Peyrot <linkmauve@linkmauve.fr>
# Maintainer: Terromur <terromuroz@proton.me>

pkgbase="dav1d-git"
_gitname=${pkgbase%-git}
pkgname=(
  dav1d-git
)
pkgver=1.5.4.r30.g7f12cf2
pkgrel=1
pkgdesc="AV1 cross-platform decoder focused on speed and correctness"
url="https://code.videolan.org/videolan/dav1d"
license=(BSD-2-Clause)
arch=(x86_64)
makedepends=(
  doxygen
  git
  graphviz
  meson
  nasm
  ninja
  vulkan-headers
  xxhash
)
source=(
  "git+$url.git"
  "git+$url-test-data.git"
)
b2sums=(
  SKIP
  SKIP
)
prepare() {
  cd "$_gitname"
  ln -fs "$srcdir/dav1d-test-data" tests/dav1d-test-data
}
pkgver() {
  cd "$_gitname"
  git describe --long --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}
build() {
  meson setup --prefix=/usr --buildtype=release \
    -Dpython.bytecompile=2 \
    -Db_pie=false \
    -D debug=false \
    -D strip=true \
    -D b_lto=true \
    -D errorlogs=false \
    -D logging=false \
    "$_gitname" build
  ninja -C build all
}

check() {
  meson test -C build --print-errorlogs
}

package_dav1d-git() {
  depends=(glibc)
  provides=(libdav1d.so dav1d)
  conflicts=(dav1d)
  optdepends=("dav1d-doc-git: HTML documentation")

  meson install -C build --destdir "$pkgdir"

  cd "$_gitname"
  install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
