# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan De Groot <jgc@archlinux.org>
# Maintainr: Terromur <terromuroz@proton.me>

pkgname=gnome-keyring-git
pkgver=51.0+5+ge13215e6
pkgrel=2
epoch=1
pkgdesc="Stores passwords and encryption keys"
url="https://gitlab.gnome.org/GNOME/gnome-keyring"
arch=(x86_64)
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  dconf
  gcr
  gcr-4
  glib2
  glibc
  libcap-ng
  libgcc
  libgcrypt
  pam
  systemd-libs
)
makedepends=(
  docbook-xsl
  git
  glib2-devel
  meson
  p11-kit
  python
)
provides=(org.freedesktop.secrets)
groups=(gnome)
install=gnome-keyring.install
source=(
  "git+$url.git"
  prompt-crash.patch
  04a6bc68ff4350676c5fc55d1b244a17224fbea2.patch
)
b2sums=('SKIP'
        'SKIP'
        'SKIP')
validpgpkeys=(
  A7C626E13F9AD776776BD9CA1D8A57CF2E8D36A3 # Niels De Graef (nielsdg) <nielsdegraef@gmail.com>
)

pkgver() {
  cd gnome-keyring
  git describe --tags | sed 's/^v//; s/-/+/g'
}

prepare() {
  cd gnome-keyring
  
  git apply -3 ../prompt-crash.patch
  
  git apply -3 ../04a6bc68ff4350676c5fc55d1b244a17224fbea2.patch
}

build() {
  local meson_options=(
    -D selinux=disabled
    --buildtype=release
    -Dpython.bytecompile=2
    -Db_pie=false
    -D debug=false
    -D strip=true
    -D b_lto=true
    -D errorlogs=false
    -D debug-mode=false
  )

  arch-meson gnome-keyring build "${meson_options[@]}"
  meson compile -C build
}

check() {
  # Secure memory tests fail
  dbus-run-session meson test -C build --print-errorlogs || :
}

package() {
  provides+=(gnome-keyring)
  conflicts=(gnome-keyring)

  meson install -C build --no-rebuild --destdir "$pkgdir"
}

# vim:set sw=2 sts=-1 et:
